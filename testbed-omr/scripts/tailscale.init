#!/bin/sh /etc/rc.common
# procd init script for the static Tailscale binary on OpenMPTCProuter.
# Install to /etc/init.d/tailscale, then: /etc/init.d/tailscale enable
START=90
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/tailscaled \
		--state=/etc/tailscale/tailscaled.state \
		--statedir=/etc/tailscale \
		--port=41641
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
